<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Diagnostics\Diagnostics.csproj" Condition="'$(CompletionPackageMode)' != 'true'" />
    <ProjectReference Include="..\Completion.Abstractions\Completion.Abstractions.csproj" Condition="'$(CompletionPackageMode)' != 'true'" />
    <PackageReference Include="Atelia.Diagnostics" Version="$(CompletionDependencyVersionDiagnostics)" Condition="'$(CompletionPackageMode)' == 'true'" />
    <PackageReference Include="Atelia.Completion.Abstractions" Version="$(CompletionDependencyVersionAbstractions)" Condition="'$(CompletionPackageMode)' == 'true'" />
  </ItemGroup>

</Project>
